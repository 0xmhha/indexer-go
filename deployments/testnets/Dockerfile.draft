# Build recipe only; no build/pull is part of draft validation.
FROM golang:1.26.8-bookworm AS builder
ENV GOTOOLCHAIN=local CGO_ENABLED=1
WORKDIR /src
COPY go.mod go.sum ./
COPY execwire/ ./execwire/
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY pkg/ ./pkg/
COPY x/ ./x/
# One image holds the three binaries; each Compose service selects its chain's
# with INDEXER_BINARY (indexer-entrypoint.sh).
RUN go build -trimpath -o /out/indexer ./cmd/indexer
RUN go build -trimpath -o /out/indexer-stablenet ./x/stablenet/cmd/indexer-stablenet
RUN go build -trimpath -o /out/indexer-arc ./x/arc/cmd/indexer-arc
RUN go build -trimpath -o /out/indexer-inspect ./cmd/indexer-inspect

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app /opt/indexer
COPY --from=builder /out/indexer /out/indexer-stablenet /out/indexer-arc /app/
COPY --from=builder /out/indexer-inspect /app/indexer-inspect
WORKDIR /app
# Compose supplies the invoking non-root host UID/GID, including for secrets.
USER 1000:1000
EXPOSE 8088 8089 8090 8091
ENTRYPOINT ["/app/indexer"]
