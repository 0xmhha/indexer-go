# Build recipe only; no build/pull is part of draft validation.
FROM golang:1.26.8-bookworm AS builder
ENV GOTOOLCHAIN=local CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY pkg/ ./pkg/
# The multi-chain draft configuration runs StableNet and Arc chains, whose
# profiles moved to x/stablenet and x/arc; ./cmd/indexer links the generic
# EVM profile only. Splitting the draft into one service per chain binary
# (indexer-stablenet, indexer-arc, indexer) is pending.
RUN go build -trimpath -o /out/indexer-go ./cmd/indexer
RUN go build -trimpath -o /out/indexer-inspect ./cmd/indexer-inspect

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app /opt/indexer
COPY --from=builder /out/indexer-go /app/indexer-go
COPY --from=builder /out/indexer-inspect /app/indexer-inspect
WORKDIR /app
# Compose supplies the invoking non-root host UID/GID, including for secrets.
USER 1000:1000
EXPOSE 8088
ENTRYPOINT ["/app/indexer-go"]
